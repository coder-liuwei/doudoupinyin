exports[`render — ruby structure > renders punctuation as <span class='unit punct'> without ruby 1`] = `
<div>
  <p
    className="line"
  >
    <span
      className="unit"
    >
      <ruby>
        <span
          className="rb"
        >
          你
        </span>
        <rt>
          nǐ
        </rt>
      </ruby>
    </span>
